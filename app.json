{
  "expo": {
    "name": "Reste",
    "slug": "reste",
    "version": "0.1.0",
    "scheme": "reste",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.reste",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.example.reste",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C3A31"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Reste utilise l'appareil photo pour lire vos devis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Reste accède à vos photos pour lire un devis déjà photographié."
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5F4F1",
          "dark": {
            "backgroundColor": "#121315"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
